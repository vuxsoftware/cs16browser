{
  "name": "cs16browser",
  "version": "0.1.0",
  "description": "",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/vuxsoftware/cs16browser.git"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "fallow": "fallow dead-code",
    "fallow:report": "fallow",
    "quality:frontend": "bun run format:check && bun run lint && bun run check && bun run test && bun run coverage && bun run fallow && node scripts/check-version.mjs && bun run site:check",
    "tauri": "tauri",
    "site": "node scripts/build-site.mjs",
    "site:check": "node scripts/build-site.mjs --check",
    "version:set": "node scripts/set-version.mjs"
  },
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.12.0",
    "flag-icons": "^7.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-svelte": "^3.23.0",
    "fallow": "^3.28.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "svelte-eslint-parser": "^1.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.0.16",
    "vitest": "^5.0.1"
  }
}
