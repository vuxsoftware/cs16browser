{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cs16browser",
  "version": "0.1.0",
  "identifier": "com.cs16browser.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "cs16browser v0.1.0",
        "width": 1280,
        "height": 720,
        "minWidth": 1024,
        "minHeight": 576,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "visible": false,
        "center": true,
        "backgroundColor": "#4c5844"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhCQjJDMTdBQTY5NjYwRDkKUldUWllKYW1lc0d5aTgwa2Q5OTc2UlRkZGhuVkpodnRYM1NTMEZZVXV4ZEt1L0dpQmRaN0paalkK",
      "endpoints": ["https://github.com/vuxsoftware/cs16browser/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
